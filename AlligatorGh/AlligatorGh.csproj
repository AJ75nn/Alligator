<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Select the framework(s) you wish to target.
        Rhino 6: net45
        Rhino 7: net48
        Rhino 8 Windows: net48, net7.0, net7.0-windows, net7.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net7.0, net7.0-macos, net7.0-macos12.0, etc
    -->
		<TargetFrameworks>net7.0-windows;net7.0;net48</TargetFrameworks>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<TargetExt>.gha</TargetExt>
		<NoWarn>NU1701;NETSDK1086</NoWarn>
		<LangVersion>latest</LangVersion>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Specifies information for Assembly and Yak -->
		<Version>1.0</Version>
		<Title>AlligatorGh</Title>
		<Company>AlligatorGh Authors</Company>
		<Description>Description of AlligatorGh</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grasshopper" Version="8.28.26041.11001" ExcludeAssets="runtime" />
		<PackageReference Include="System.Resources.Extensions" Version="10.0.8" />
	</ItemGroup>

	<!-- For Windows only builds -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4'))">
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<!-- WPF is Windows-only and not used on net48 here (Rhino 8 Windows loads the net7.0-windows gha).
	     Enabling it only for the -windows TFM keeps the net7.0 (Mac) and net48 targets building.
	     The WPF symbol guards the Plugin Manager window + its menu wiring; on Mac/net48 the menu
	     item is simply not added. -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
		<UseWpf>true</UseWpf>
		<DefineConstants>$(DefineConstants);WPF</DefineConstants>
	</PropertyGroup>

	<!-- Keep all WPF sources (XAML + code-behind) out of the non-Windows compilations entirely.
	     A .xaml markup file cannot be #if-guarded, so it must be removed as a build item here. -->
	<ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
		<Compile Remove="Components\UI\PlugInManager\Wpf\**\*.cs" />
		<Page Remove="Components\UI\PlugInManager\Wpf\**\*.xaml" />
		<ApplicationDefinition Remove="Components\UI\PlugInManager\Wpf\**\*.xaml" />
		<Compile Remove="Components\UI\Dashboard\Wpf\**\*.cs" />
		<Page Remove="Components\UI\Dashboard\Wpf\**\*.xaml" />
		<ApplicationDefinition Remove="Components\UI\Dashboard\Wpf\**\*.xaml" />
		<Compile Remove="Components\UI\ThemeCustomizer\Wpf\**\*.cs" />
		<Page Remove="Components\UI\ThemeCustomizer\Wpf\**\*.xaml" />
		<ApplicationDefinition Remove="Components\UI\ThemeCustomizer\Wpf\**\*.xaml" />
	</ItemGroup>

	<!-- Reference WinForms for .NET 7.0 on macOS -->
	<ItemGroup Condition="!($(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4')))">
		<!-- Rhino 8.11 and later you can use this -->
		<!-- <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" /> -->

		<!-- Rhino 8.10 and earlier -->
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" ExcludeAssets="all" GeneratePathProperty="true" />
		<Reference Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\.NETFramework\v4.8\System.Windows.Forms.dll" Private="False" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.8" ExcludeAssets="runtime" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\AlligatorCore\AlligatorCore.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\*.png" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="References\**" />
		<EmbeddedResource Remove="References\**" />
		<None Remove="References\**" />
	</ItemGroup>

</Project>