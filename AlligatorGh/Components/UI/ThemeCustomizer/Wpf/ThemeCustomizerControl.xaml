<UserControl x:Class="AlligatorGh.Components.UI.ThemeCustomizer.Wpf.ThemeCustomizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AlligatorGh.Components.UI.ThemeCustomizer.Wpf.ViewModels"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AlligatorGh;component/Components/UI/PlugInManager/Wpf/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BaseThemeRadioButton" TargetType="RadioButton">
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Surface" CornerRadius="8" Background="{DynamicResource Brush.Card.Background}" Margin="0,0,10,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource Color.Shadow.Dark}" Direction="315" ShadowDepth="1.5" BlurRadius="5" Opacity="0.35" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Brush.Text}" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                    <Setter TargetName="Surface" Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent.Text}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Theme Settings" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,14" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <!-- Base Theme Card -->
                <Border CornerRadius="8" Background="{DynamicResource Brush.Surface.Alt}" Padding="14" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Base Theme" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Default" Style="{StaticResource BaseThemeRadioButton}" IsChecked="{Binding IsDefaultBaseTheme, Mode=OneWay}" Command="{Binding SetDefaultBaseThemeCommand}" />
                                <RadioButton Content="Dark" Style="{StaticResource BaseThemeRadioButton}" IsChecked="{Binding IsDarkBaseTheme, Mode=OneWay}" Command="{Binding SetDarkBaseThemeCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ResetAllCommand}" Content="Reset All" VerticalAlignment="Bottom" Height="40" />
                    </Grid>
                </Border>

                <!-- Colors Card -->
                <Border CornerRadius="8" Background="{DynamicResource Brush.Surface.Alt}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Custom Colors" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,14" />

                        <ItemsControl ItemsSource="{Binding ColorProperties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />

                                        <Grid Grid.Column="2" Margin="0,0,10,0">
                                            <Button x:Name="ColorPreviewBorder" Width="60" Height="24" Cursor="Hand" Command="{Binding TogglePopupCommand}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding CurrentColorMedia}" />
                                                            </Border.Background>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Popup IsOpen="{Binding IsPopupOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=ColorPreviewBorder}" Placement="Bottom" AllowsTransparency="True" Opened="Popup_Opened">
                                                <Border CornerRadius="12" Background="{DynamicResource Brush.Card.Background}" Padding="14" Margin="0,5,10,10" Width="200">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="{DynamicResource Color.Shadow.Dark}" Direction="315" ShadowDepth="3" BlurRadius="8" Opacity="0.45" />
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <TextBlock Text="Color Picker" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,10"/>

                                                        <!-- Saturation / Brightness Picker -->
                                                        <Grid x:Name="SVPicker" Height="120" Margin="0,0,0,10" ClipToBounds="True"
                                                              MouseLeftButtonDown="SVPicker_MouseLeftButtonDown"
                                                              MouseMove="SVPicker_MouseMove"
                                                              MouseLeftButtonUp="SVPicker_MouseLeftButtonUp">
                                                            <Grid.Background>
                                                                <SolidColorBrush Color="{Binding HueColorMedia}" />
                                                            </Grid.Background>
                                                            <Border>
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="White" Offset="0"/>
                                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <Border>
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="Transparent" Offset="0"/>
                                                                        <GradientStop Color="Black" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>

                                                            <!-- SV Picker Thumb -->
                                                            <Canvas>
                                                                <Ellipse x:Name="SVThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent"
                                                                         IsHitTestVisible="False">
                                                                    <Ellipse.Effect>
                                                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.5"/>
                                                                    </Ellipse.Effect>
                                                                </Ellipse>
                                                            </Canvas>
                                                        </Grid>

                                                        <!-- Hue Slider -->
                                                        <Grid x:Name="HueSlider" Height="16" Margin="0,0,0,10"
                                                              MouseLeftButtonDown="HueSlider_MouseLeftButtonDown"
                                                              MouseMove="HueSlider_MouseMove"
                                                              MouseLeftButtonUp="HueSlider_MouseLeftButtonUp">
                                                            <Border CornerRadius="8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#FF0000" Offset="0"/>
                                                                        <GradientStop Color="#FFFF00" Offset="0.166"/>
                                                                        <GradientStop Color="#00FF00" Offset="0.333"/>
                                                                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                                                                        <GradientStop Color="#0000FF" Offset="0.666"/>
                                                                        <GradientStop Color="#FF00FF" Offset="0.833"/>
                                                                        <GradientStop Color="#FF0000" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <Canvas>
                                                                <Ellipse x:Name="HueThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2" Fill="Transparent"
                                                                         Canvas.Top="0" IsHitTestVisible="False">
                                                                    <Ellipse.Effect>
                                                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.5"/>
                                                                    </Ellipse.Effect>
                                                                </Ellipse>
                                                            </Canvas>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="30" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                                <TextBox Text="{Binding HexColor, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Background="{DynamicResource Brush.Surface.Alt}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" FontSize="11" FontWeight="Bold" HorizontalContentAlignment="Center"/>
                                                                <TextBlock Text="#" Foreground="{DynamicResource Brush.Muted.Text}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                                                <TextBox Text="{Binding RValue, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Background="{DynamicResource Brush.Surface.Alt}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" FontSize="11" HorizontalContentAlignment="Center"/>
                                                                <TextBlock Text="R" Foreground="{DynamicResource Brush.Muted.Text}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Margin="2,0,2,0">
                                                                <TextBox Text="{Binding GValue, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Background="{DynamicResource Brush.Surface.Alt}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" FontSize="11" HorizontalContentAlignment="Center"/>
                                                                <TextBlock Text="G" Foreground="{DynamicResource Brush.Muted.Text}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="3" Margin="2,0,0,0">
                                                                <TextBox Text="{Binding BValue, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Background="{DynamicResource Brush.Surface.Alt}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" FontSize="11" HorizontalContentAlignment="Center"/>
                                                                <TextBlock Text="B" Foreground="{DynamicResource Brush.Muted.Text}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>

                                        <Button Grid.Column="3" Content="Reset" Style="{StaticResource GhostButton}" Command="{Binding ResetCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Ribbon Font Size -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Ribbon Font Size" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />

                            <TextBox Grid.Column="2" Width="60" Height="24" Text="{Binding RibbonFontSizeText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource Brush.Card.Background}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>